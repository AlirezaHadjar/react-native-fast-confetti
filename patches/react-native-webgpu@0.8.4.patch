+// Dawn's native queue owns mutable command-encoding state. A GPUQueue can be
+// boxed into several JSI runtimes, while SurfaceInfo also reaches the same
+// native queue directly for its offscreen-to-onscreen blit. Serialize those
+// entry points by native queue identity so two runtimes cannot mutate one
+// Dawn queue concurrently.
+class QueueSynchronization {
+public:
+  using Mutex = std::mutex;
+
+  static std::shared_ptr<Mutex> mutexFor(const wgpu::Queue &queue) {
+    const auto handle = queue.Get();
+    std::lock_guard<std::mutex> registryLock(registryMutex());
+    auto &locks = registry();
+
+    auto existing = locks.find(handle);
+    if (existing != locks.end()) {
+      if (auto mutex = existing->second.lock()) {
+        return mutex;
+      }
+      locks.erase(existing);
+    }
+
+    // Queue handles are few, but remove expired entries opportunistically so
+    // repeated device loss/recreation cannot grow this process-wide registry.
+    for (auto it = locks.begin(); it != locks.end();) {
+      if (it->second.expired()) {
+        it = locks.erase(it);
+      } else {
+        ++it;
+      }
+    }
+
+    auto mutex = std::make_shared<Mutex>();
+    locks.emplace(handle, mutex);
+    return mutex;
+  }
+
+private:
+  static std::unordered_map<WGPUQueue, std::weak_ptr<Mutex>> &registry() {
+    static std::unordered_map<WGPUQueue, std::weak_ptr<Mutex>> locks;
+    return locks;
+  }
+
+  static std::mutex &registryMutex() {
+    static std::mutex mutex;
+    return mutex;
+  }
+};
