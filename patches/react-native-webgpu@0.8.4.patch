+} // namespace detail
+
+// Dispatch before acquiring SurfaceInfo locks. Dispatching while holding one
+// can deadlock against a main-thread frame waiting for the same surface.
+template <typename Function>
+auto RunOnMainThreadSync(Function &&function)
+    -> std::invoke_result_t<Function> {
+  using Result = std::invoke_result_t<Function>;
+  if (pthread_main_np() != 0) {
+    return std::forward<Function>(function)();
+  }
+
+  std::exception_ptr error;
+  if constexpr (std::is_void_v<Result>) {
+    std::function<void()> callable = [&]() {
+      try {
+        std::forward<Function>(function)();
+      } catch (...) {
+        error = std::current_exception();
+      }
+    };
+    dispatch_sync_f(dispatch_get_main_queue(), &callable,
+                    detail::RunOnMainThreadInvoke);
+    if (error) {
+      std::rethrow_exception(error);
+    }
+  } else {
+    std::optional<Result> result;
+    std::function<void()> callable = [&]() {
+      try {
+        result.emplace(std::forward<Function>(function)());
+      } catch (...) {
+        error = std::current_exception();
+      }
+    };
+    dispatch_sync_f(dispatch_get_main_queue(), &callable,
+                    detail::RunOnMainThreadInvoke);
+    if (error) {
+      std::rethrow_exception(error);
+    }
+    return std::move(*result);
+  }
+}
