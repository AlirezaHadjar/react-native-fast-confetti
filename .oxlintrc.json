{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "react", "jest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/no-new-array": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "jest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectInRange",
          "expectPhaseOffsetsAreStratified"
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "__DEV__": "readonly"
  },
  "ignorePatterns": [
    ".context/**",
    "lib/**",
    "dist/**",
    "coverage/**",
    "**/ios/**",
    "**/android/**"
  ],
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react-native-webgpu",
                "message": "The default entry must work without the optional WebGPU peers. Only src/webgpu and src/gpu may import them; use `import type` for types.",
                "allowTypeImports": true
              },
              {
                "name": "typegpu",
                "message": "The default entry must work without the optional WebGPU peers. Only src/webgpu and src/gpu may import them; use `import type` for types.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["react-native-webgpu/*", "typegpu/*"],
                "message": "The default entry must work without the optional WebGPU peers. Only src/webgpu and src/gpu may import them; use `import type` for types.",
                "allowTypeImports": true
              },
              {
                "regex": "(^|/)webgpu(/|$)",
                "message": "The default entry must work without the optional WebGPU peers. Only src/webgpu and src/gpu may import them; use `import type` for types.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/webgpu/**",
        "src/gpu/**",
        "src/__tests__/**",
        "src/__fixtures__/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
