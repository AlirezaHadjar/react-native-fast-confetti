{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "react", "jest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/no-new-array": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "__DEV__": "readonly"
  },
  "ignorePatterns": [
    ".context/**",
    "lib/**",
    "dist/**",
    "coverage/**",
    "**/ios/**",
    "**/android/**"
  ]
}
