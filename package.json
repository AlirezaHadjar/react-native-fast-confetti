{
  "name": "react-native-fast-confetti",
  "version": "2.0.2",
  "description": "The fastest confetti animation library in react native",
  "sideEffects": false,
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!coverage",
    "!coverage/**",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun --cwd example run",
    "kitchen-sink": "bun --cwd kitchen-sink run",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc",
    "lint": "oxlint .",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlirezaHadjar/react-native-fast-confetti.git"
  },
  "author": "Alireza Hadjar <asiahadjar@gmail.com> (https://github.com/AlirezaHadjar)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlirezaHadjar/react-native-fast-confetti/issues"
  },
  "homepage": "https://github.com/AlirezaHadjar/react-native-fast-confetti#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@evilmartians/lefthook": "^2.2.1",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "react-native-skia": "3.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "commitlint": "^21.2.3",
    "del-cli": "^8.0.1",
    "jest": "^30.5.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "release-it": "^21.1.1",
    "typescript": "~7.0.2",
    "oxlint": "^1.87.0",
    "oxfmt": "^0.72.0"
  },
  "peerDependencies": {
    "react-native-skia": ">=3.0.0 <4",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=4.1.0 <5",
    "react-native-worklets": ">=0.7.0 <1"
  },
  "workspaces": [
    "example",
    "kitchen-sink"
  ],
  "packageManager": "bun@1.3.14",
  "overrides": {
    "zod-validation-error": "4.0.2"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/.context/",
      "<rootDir>/example/node_modules",
      "<rootDir>/kitchen-sink/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.50.2"
  }
}
